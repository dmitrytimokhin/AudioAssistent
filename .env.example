# cp .env.example .env  — читается и docker compose, и приложением, запущенным напрямую.

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=audio
# Порт на хосте (контейнер postgres слушает 5432 внутри). Для приложения без Docker:
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Ollama (на хосте, не в Docker: на Mac в контейнере нет GPU) ─────
# Для приложения в Docker compose сам подставит http://host.docker.internal:11434.
# Для приложения без Docker адрес по умолчанию http://localhost:11434, менять не нужно.
OLLAMA_MODEL_NAME=qwen3.5:4b

# ── Whisper в контейнере (CPU). Вне Docker на Mac используется mlx-whisper ──
WHISPER_MODEL=large-v3-turbo

# ── Сервис ──────────────────────────────────────────────────
ASSISTANT_DEFAULT_AUDIENCE=management
# Разметка говорящих: llm — модель чанками (при сбое чанк размечается правилами), rules — только правила
ASSISTANT_ATTRIBUTION_METHOD=llm
# Размер чанка в символах: короче — один вызов; ориентир ~2,5 символа на токен, должно влезать в контекст модели
ASSISTANT_ATTRIBUTION_CHUNK_CHARS=6000
# Контекст с каждой стороны чанка (добавляется к размеру чанка, нужен запас num_ctx)
ASSISTANT_ATTRIBUTION_CONTEXT_UNITS=12
# Проверка моделей и зависимостей при старте (Ollama и её модель, Whisper, ffmpeg, Postgres, папки, промпты):
# warn — результат в лог, strict — сервис не стартует при ошибке, off — не проверять
ASSISTANT_STARTUP_CHECK=warn
# Докачивать модель Whisper в фоне при старте (иначе она скачается при первой транскрибации, ~1,5 ГБ)
ASSISTANT_PRELOAD_WHISPER=true
# Разбор встреч и сводки: транскрипт длиннее режется на части этого размера (символы)
ASSISTANT_ANALYSIS_CHUNK_CHARS=12000
# Разбор картинок: длинная сторона фото перед отправкой модели (px), картинок в одном запросе, МБ на файл
ASSISTANT_IMAGE_MAX_SIDE=1568
ASSISTANT_IMAGE_MAX_PER_REQUEST=8
ASSISTANT_IMAGE_MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
