# cp .env.example .env  — читается и docker compose, и приложением, запущенным напрямую.

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=audio
# Порт на хосте (контейнер postgres слушает 5432 внутри). Для приложения без Docker:
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Ollama (на хосте, не в Docker: на Mac в контейнере нет GPU) ─────
# Для приложения в Docker compose сам подставит http://host.docker.internal:11434.
# Для приложения без Docker адрес по умолчанию http://localhost:11434, менять не нужно.
OLLAMA_MODEL_NAME=qwen3.5:4b

# ── Whisper в контейнере (CPU). Вне Docker на Mac используется mlx-whisper ──
WHISPER_MODEL=large-v3-turbo

# ── Сервис ──────────────────────────────────────────────────
ASSISTANT_DEFAULT_AUDIENCE=management
# Разметка говорящих: llm — модель чанками (при сбое чанк размечается правилами), rules — только правила
ASSISTANT_ATTRIBUTION_METHOD=llm
# Размер чанка в символах: короче — один вызов; ориентир ~2,5 символа на токен, должно влезать в контекст модели
ASSISTANT_ATTRIBUTION_CHUNK_CHARS=6000
LOG_LEVEL=INFO
